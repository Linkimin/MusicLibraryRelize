<Window x:Class="MusicLibrary.Views.TagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicBakh — Теги"
        Icon="../Assets/Brand/musicbakh.ico"
        Width="560"
        Height="540"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Управление тегами"
                   FontFamily="{StaticResource HeadingFont}"
                   Foreground="{StaticResource PrimaryBrush}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <!-- Создание нового тега -->
        <Border Grid.Row="1" Padding="14" CornerRadius="8" Background="#3316161F"
                BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Новый тег" Foreground="{StaticResource ForegroundBrush}"
                           FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Style="{StaticResource SearchTextBoxStyle}"
                             Tag="Имя нового тега"
                             Text="{Binding NewTagName, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Content="＋ Создать"
                            Command="{Binding CreateTagCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Height="36"
                            Padding="14,0"
                            Margin="10,0,0,0"
                            IsDefault="True" />
                </Grid>
                <ItemsControl ItemsSource="{Binding PresetColors}" Margin="0,10,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="22" Height="22" CornerRadius="11" Margin="0,0,8,0" Cursor="Hand"
                                    BorderBrush="{StaticResource ForegroundBrush}" BorderThickness="1">
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding}" />
                                </Border.Background>
                                <Border.InputBindings>
                                    <MouseBinding MouseAction="LeftClick"
                                                  Command="{Binding DataContext.PickNewColorCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  CommandParameter="{Binding}" />
                                </Border.InputBindings>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Список существующих тегов -->
        <ListBox Grid.Row="2"
                 ItemsSource="{Binding Tags}"
                 SelectedItem="{Binding SelectedTag, Mode=TwoWay}"
                 Style="{StaticResource PanelListBoxStyle}"
                 Margin="0,0,0,12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse Grid.Column="0" Width="14" Height="14" Margin="0,0,10,0"
                                 Stroke="{StaticResource ForegroundBrush}" StrokeThickness="1">
                            <Ellipse.Fill>
                                <SolidColorBrush Color="{Binding Color, FallbackValue=#D4A574, TargetNullValue=#D4A574}" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <TextBlock Grid.Column="1" Text="{Binding Name}"
                                   Foreground="{StaticResource ForegroundBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Редактирование выбранного -->
        <Grid Grid.Row="3" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0"
                     Style="{StaticResource SearchTextBoxStyle}"
                     Tag="Переименовать выбранный тег"
                     Text="{Binding RenameInput, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1"
                    Content="Переименовать"
                    Command="{Binding RenameTagCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="36"
                    Padding="14,0"
                    Margin="10,0,0,0" />
            <Button Grid.Column="2"
                    Content="Удалить"
                    Command="{Binding DeleteTagCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Height="36"
                    Padding="14,0"
                    Margin="10,0,0,0" />
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="{Binding ErrorMessage}"
                   Foreground="{StaticResource ErrorBrush}"
                   TextWrapping="Wrap"
                   MinHeight="18" />
    </Grid>
</Window>
