<Window x:Class="MusicLibrary.Views.StatsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MusicBakh — Статистика"
        Icon="../Assets/Brand/musicbakh.ico"
        Width="720"
        Height="620"
        FontFamily="{StaticResource BodyFont}"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        KeyDown="OnWindowKeyDown">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Статистика прослушиваний"
                       FontFamily="{StaticResource HeadingFont}"
                       Foreground="{StaticResource PrimaryBrush}"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </StackPanel>

        <TabControl Grid.Row="1" Style="{StaticResource StatsTabControlStyle}">
            <TabItem Header="Топ-50">
                <Grid>
                    <ListBox ItemsSource="{Binding Top}"
                             Style="{StaticResource PanelListBoxStyle}"
                             ItemTemplate="{StaticResource StatsTopItemTemplate}"
                             Visibility="{Binding HasTop, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="Пока ничего не прослушано — топ-50 появится после первых прослушиваний."
                               Foreground="{StaticResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="40"
                               Visibility="{Binding HasTop, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Недавние">
                <Grid>
                    <ListBox ItemsSource="{Binding Recent}"
                             Style="{StaticResource PanelListBoxStyle}"
                             ItemTemplate="{StaticResource StatsRecentItemTemplate}"
                             Visibility="{Binding HasRecent, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="История пуста."
                               Foreground="{StaticResource MutedForegroundBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="40"
                               Visibility="{Binding HasRecent, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </TabItem>
            <TabItem Header="Ни разу не играли">
                <Grid>
                    <ListBox ItemsSource="{Binding NeverPlayed}"
                             Style="{StaticResource PanelListBoxStyle}"
                             ItemTemplate="{StaticResource StatsNeverPlayedItemTemplate}"
                             Visibility="{Binding HasNeverPlayed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Text="Все треки в библиотеке уже играли хотя бы один раз."
                               Foreground="{StaticResource MutedForegroundBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="40"
                               Visibility="{Binding HasNeverPlayed, Converter={StaticResource InverseBooleanToVisibilityConverter}}" />
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
